{
  "name": "polymock",
  "version": "0.1.0",
  "description": "A local mock server with multi-protocol support (HTTP/WebSocket) and dynamic runtime route registration — mock internal APIs during local development without switching networks.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "build": "tsc && vite build -c web/vite.config.ts",
    "build:web": "vite build -c web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "typecheck:web": "vue-tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
